.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    picking-mode: ignore;
}

.hud-left {
    position: absolute;
    left: 16px;
    top: 16px;
    flex-direction: column;
    align-items: flex-start;
    picking-mode: ignore;
}

.health-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.heart-icon {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    background-color: rgba(220, 50, 50, 0);
    border-radius: 50%;
    background-image: url("project://database/Assets/Sprites/vinyl/heart.png?fileID=2800000&guid=65056b5d778a1e848ad69f23ff0a5bc6&type=3#heart");
    background-size: 100% 100%;
    background-position-x: center;
    background-position-y: center;
}

.health-bar-bg {
    width: 160px;
    height: 14px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    overflow: hidden;
    margin-right: 8px;
}

.health-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(80, 220, 80);
    border-radius: 7px;
    transition-property: width, background-color;
    transition-duration: 0.2s;
}

.health-bar-fill--mid {
    background-color: rgb(220, 200, 50);
}

.health-bar-fill--low {
    background-color: rgb(220, 60, 60);
}

.health-text {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
    -unity-font-style: bold;
    min-width: 60px;
    -unity-font-definition: url("project://database/Assets/Fonts/Bangers-Regular.ttf?fileID=12800000&guid=1f8be9921b2840f439a7d0bfbc8d4efc&type=3#Bangers-Regular");
}

.vinyl-row {
    flex-direction: row;
    align-items: center;
}

.vinyl-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    background-color: rgb(180, 180, 180);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(80, 80, 80);
    background-image: url("project://database/Assets/Sprites/vinyl/Vinyl.png?fileID=2800000&guid=15ffa19fb9075774387923b7149b9dc0&type=3#Vinyl");
}

.vinyl-count {
    font-size: 15px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Bangers-Regular.ttf?fileID=12800000&guid=1f8be9921b2840f439a7d0bfbc8d4efc&type=3#Bangers-Regular");
}

.hud-right {
    position: absolute;
    right: 16px;
    top: 16px;
    align-items: flex-end;
    picking-mode: ignore;
}

.fragment-label {
    font-size: 15px;
    color: rgba(255, 215, 0, 0.6);
    letter-spacing: 2px;
    margin-bottom: 4px;
    -unity-font-definition: url("project://database/Assets/Fonts/Bangers-Regular.ttf?fileID=12800000&guid=1f8be9921b2840f439a7d0bfbc8d4efc&type=3#Bangers-Regular");
}

.fragment-slots {
    flex-direction: row;
    align-items: center;
}

.fragment-slot {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    margin-left: 6px;
    background-color: rgba(80, 80, 80, 0.6);
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.2);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.3s;
}

.fragment-slot--collected {
    background-color: rgb(255, 215, 0);
    border-color: rgb(255, 240, 100);
    scale: 1.15;
    background-image: url("project://database/Assets/Sprites/vinyl/frag.png?fileID=2800000&guid=db0d1694578373c408af1633f5d8d16f&type=3#frag");
}

.hud-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    align-items: center;
    picking-mode: ignore;
}

.beat-indicator {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 20px;
    padding: 6px 14px;
}

.beat-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.2);
    margin-left: 6px;
    margin-right: 6px;
    transition-property: background-color, scale;
    transition-duration: 0.05s;
}

.beat-dot--active {
    background-color: rgb(255, 215, 0);
    scale: 1.4;
}

.beat-dot--downbeat {
    background-color: rgb(255, 255, 255);
    scale: 1.6;
}
