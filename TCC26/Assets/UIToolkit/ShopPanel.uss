.shop-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
    display: flex;
}

.shop-container {
    width: 720px;
    background-color: rgb(15, 12, 20);
    border-width: 2px;
    border-color: rgb(255, 215, 0);
    border-radius: 16px;
    padding: 24px;
    flex-direction: column;
    align-items: stretch;
}

.shop-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 215, 0, 0.3);
}

.shop-title {
    font-size: 22px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.vinyl-balance {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 215, 0, 0.1);
    border-width: 1px;
    border-color: rgb(255, 215, 0);
    border-radius: 20px;
    padding: 4px 14px;
}

.vinyl-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    background-color: rgb(255, 215, 0);
    border-radius: 12px;
}

.vinyl-count {
    font-size: 16px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
}

.cards-container {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 16px;
}

.upgrade-card {
    width: 210px;
    background-color: rgb(25, 20, 35);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 16px;
    align-items: center;
    position: relative;
    transition-property: border-color, background-color;
    transition-duration: 0.2s;
}

.upgrade-card:hover {
    border-color: rgba(255, 215, 0, 0.6);
    background-color: rgb(30, 25, 45);
}

.card-icon {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-bottom: 10px;
}

.icon-amplifier {
    background-color: rgb(30, 80, 180);
}

.icon-jump {
    background-color: rgb(20, 140, 60);
}

.icon-vitality {
    background-color: rgb(160, 30, 30);
}

.card-title {
    font-size: 13px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 4px;
    letter-spacing: 1px;
}

.card-effect {
    font-size: 12px;
    color: rgb(180, 220, 255);
    -unity-text-align: upper-center;
    margin-bottom: 10px;
}

.card-price {
    font-size: 13px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 12px;
}

.card-price--cant-afford {
    color: rgb(150, 150, 150);
}

.card-price--purchased {
    color: rgb(80, 200, 80);
}

.buy-button {
    width: 100%;
    height: 36px;
    background-color: rgb(255, 215, 0);
    border-width: 0;
    border-radius: 8px;
    color: rgb(15, 12, 20);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.buy-button:hover {
    background-color: rgb(255, 230, 80);
    scale: 1.03;
}

.buy-button:active {
    background-color: rgb(200, 160, 0);
    scale: 0.97;
}

.buy-button:disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(120, 120, 120);
    opacity: 0.6;
}

.purchased-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    display: none;
}

.purchased-overlay--visible {
    display: flex;
}

.purchased-label {
    font-size: 16px;
    color: rgb(80, 220, 80);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.shop-footer {
    align-items: center;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
}

.close-hint {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 1px;
}


