<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    editor-extension-mode="False">

    <ui:VisualElement name="settings-overlay" style="position:absolute; left:0; top:0; right:0; bottom:0; background-color:rgba(0,0,0,0.75); align-items:center; justify-content:center;">

        <ui:VisualElement name="settings-container" style="width:500px; background-color:rgb(15,12,20); border-width:2px; border-color:rgb(255,215,0); border-radius:16px; padding:28px; flex-direction:column; align-items:stretch;">

            <!-- Título -->
            <ui:Label text="CONFIGURAÇÕES" style="font-size:22px; color:rgb(255,215,0); -unity-font-style:bold; -unity-text-align:upper-center; margin-bottom:24px; letter-spacing:2px;" />

            <!-- Volume Master -->
            <ui:VisualElement name="row-master" style="flex-direction:row; align-items:center; margin-bottom:16px;">
                <ui:Label text="VOLUME MASTER" style="width:180px; font-size:13px; color:rgb(200,200,200); -unity-font-style:bold;" />
                <ui:Slider name="slider-master" low-value="0" high-value="1" value="0.8" style="flex:1; margin-right:10px;" />
                <ui:Label name="label-master" text="80%" style="width:40px; font-size:12px; color:rgb(255,215,0); -unity-font-style:bold;" />
            </ui:VisualElement>

            <!-- Volume Música -->
            <ui:VisualElement name="row-music" style="flex-direction:row; align-items:center; margin-bottom:16px;">
                <ui:Label text="MÚSICA" style="width:180px; font-size:13px; color:rgb(200,200,200); -unity-font-style:bold;" />
                <ui:Slider name="slider-music" low-value="0" high-value="1" value="1" style="flex:1; margin-right:10px;" />
                <ui:Label name="label-music" text="100%" style="width:40px; font-size:12px; color:rgb(255,215,0); -unity-font-style:bold;" />
            </ui:VisualElement>

            <!-- Volume SFX -->
            <ui:VisualElement name="row-sfx" style="flex-direction:row; align-items:center; margin-bottom:24px;">
                <ui:Label text="EFEITOS SONOROS" style="width:180px; font-size:13px; color:rgb(200,200,200); -unity-font-style:bold;" />
                <ui:Slider name="slider-sfx" low-value="0" high-value="1" value="1" style="flex:1; margin-right:10px;" />
                <ui:Label name="label-sfx" text="100%" style="width:40px; font-size:12px; color:rgb(255,215,0); -unity-font-style:bold;" />
            </ui:VisualElement>

            <!-- Divisor -->
            <ui:VisualElement style="height:1px; background-color:rgba(255,215,0,0.2); margin-bottom:20px;" />

            <!-- Fullscreen -->
            <ui:VisualElement name="row-fullscreen" style="flex-direction:row; align-items:center; justify-content:space-between; margin-bottom:16px;">
                <ui:Label text="TELA CHEIA" style="font-size:13px; color:rgb(200,200,200); -unity-font-style:bold;" />
                <ui:Toggle name="toggle-fullscreen" style="margin-right:4px;" />
            </ui:VisualElement>

            <!-- Resolução -->
            <ui:VisualElement name="row-resolution" style="flex-direction:row; align-items:center; justify-content:space-between; margin-bottom:28px;">
                <ui:Label text="RESOLUÇÃO" style="font-size:13px; color:rgb(200,200,200); -unity-font-style:bold;" />
                <ui:DropdownField name="dropdown-resolution" style="width:180px;" />
            </ui:VisualElement>

            <!-- Botão Fechar -->
            <ui:Button name="btn-close-settings" text="FECHAR" style="height:40px; background-color:rgb(255,215,0); border-width:0; border-radius:8px; color:rgb(15,12,20); font-size:14px; -unity-font-style:bold;" />

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
